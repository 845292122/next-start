{
	"name": "next-start",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun run src/core/db/migrate.ts",
		"db:push": "drizzle-kit push",
		"db:reset": "bun run src/core/db/reset.ts",
		"db:seed": "bun run src/core/db/seed.ts",
		"db:studio": "drizzle-kit studio",
		"test": "bun run test:unit && bun run test:dom",
		"test:unit": "bun test --env-file=.env.local --preload ./test/unit-setup.ts src/core",
		"test:dom": "bun test --preload ./test/setup.ts src/components src/features",
		"test:coverage": "bun test --env-file=.env.local --preload ./test/unit-setup.ts src/core --coverage",
		"test:e2e": "playwright test",
		"commit": "czg"
	},
	"dependencies": {
		"@auth/drizzle-adapter": "1.11.3",
		"@libsql/client": "0.17.4",
		"@mantine/core": "9.5.1",
		"@mantine/form": "9.5.1",
		"@mantine/hooks": "9.5.1",
		"@mantine/notifications": "9.5.1",
		"@phosphor-icons/react": "2.1.10",
		"@react-email/components": "1.0.12",
		"@t3-oss/env-nextjs": "0.13.11",
		"drizzle-orm": "0.45.2",
		"geist": "^1.7.2",
		"next": "16.3.1",
		"next-auth": "5.0.0-beta.32",
		"next-intl": "4.13.7",
		"pino": "10.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"resend": "6.20.0",
		"swr": "2.5.1",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.8",
		"@happy-dom/global-registrator": "^20.11.2",
		"@playwright/test": "1.62.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "^14.6.5",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"bun-types": "^1.3.14",
		"czg": "^1.13.2",
		"dotenv": "^17.4.2",
		"drizzle-kit": "0.31.10",
		"happy-dom": "20.11.2",
		"lefthook": "2.1.10",
		"pino-pretty": "13.1.3",
		"postcss": "8.5.26",
		"postcss-preset-mantine": "1.18.0",
		"postcss-simple-vars": "7.0.1",
		"react-email": "6.9.2",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.3.3",
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=20.9.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"@parcel/watcher",
		"@swc/core",
		"better-sqlite3",
		"esbuild",
		"lefthook",
		"sharp",
		"unrs-resolver"
	]
}

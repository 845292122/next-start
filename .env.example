# A filesystem path, not a URL. SQLite needs no server and no container — the
# file is created on first run. Swap in a path on a mounted volume for
# production, or point it at a throwaway file for the e2e run.
DATABASE_URL=./data/dev.db
AUTH_SECRET=
LOG_LEVEL=info
RESEND_API_KEY=
# Sender address for core/mailer. The default is Resend's shared test sender,
# which only delivers to the address that owns the API key — replace it with an
# address on your own verified domain before real mail goes out.
EMAIL_FROM=

# The app's canonical origin, e.g. https://example.com — set this in production.
# Without it Auth.js derives callback URLs from the Host header. See DEVELOPMENT.md.
AUTH_URL=
# The public origin used for canonical links, hreflang, sitemap and OG images.
# Usually the same value as AUTH_URL. Defaults to http://localhost:3000.
APP_URL=
